# Pb X-ray escape-peak study. Fire Pb-Kalpha into one M400 CZT crystal and look
# for the Cd/Te K X-ray escape peaks in the deposited-energy spectrum. Run with:
#   ./sim pb.mac
#
# De-excitation (fluo/Auger, ignore-cut) is forced ON in physics.cc -- without
# it the escape peaks do not form.
#
# Geometry (construction.cc): crystal CZT_3 is centered at (11.256, 11.256, 0)
# mm, half size (10.375, 10.375, 5) mm -> top face at z = +5 mm. The source sits
# 3 mm above that face, firing a pencil beam straight down into it.
#
# Predicted lines for a 74.9694 keV primary:
#   full-energy   74.97
#   Cd-Ka escape  51.80   (74.97 - 23.17)   <- the feature under the 53.44 Ge
#   Te-Ka escape  47.50   (74.97 - 27.47)

/run/numberOfThreads 32
/run/initialize

/gps/particle gamma
/gps/pos/type Point
/gps/position 11.256 11.256 8 mm
/gps/direction 0 0 -1
/gps/ene/type Mono
/gps/ene/mono 74.9694 keV

/run/beamOn 20000000

# To reproduce the full data comb, add the other Pb lines -- Ka1 72.804 (Cd-esc
# 49.63) and Kb ~84.9 (Cd-esc 61.7) -- as extra GPS sources via /gps/source/add,
# or rerun this macro at each energy and sum the spectra.
