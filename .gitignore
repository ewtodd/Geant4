# Ignore all build folders anywhere in the repository
build/

# Ignore all image files anywhere in the repository
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.tiff
*.ico
*.svg
*.pdf
*.root


# Simulation outputs live on /labdata; each project reaches them through
# this symlink. OutputMerger.hh writes <stem>.root.tmp while merging.
**/macros/root_files
*.root.tmp

# ACLiC build products of the analysis macros
*_cpp.so
*_cpp.d
*_cpp_ACLiC_dict_rdict.pcm
AutoDict_*

# Libraries a project's Makefile builds from its src/ (Analysis-Utilities'
# template), which the dev shell puts on LD_LIBRARY_PATH
obj/
lib/
